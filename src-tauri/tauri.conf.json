{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwagEx",
  "version": "0.1.17",
  "identifier": "com.jmlebret.swagex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SwagEx",
        "width": 760,
        "height": 760,
        "minWidth": 680,
        "minHeight": 760,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQzI0RTg2MEY5NkVFQ0QKUldUTjdwWVBoazdDZ0dXTng1VGlTNk9vQ3BjSXVXcU5ibUoycllWRHZJSTFERkxCck5DdFRHVXkK",
      "endpoints": [
        "https://github.com/mx-design-ux/SwagEx/releases/latest/download/latest.json"
      ]
    }
  }
}
